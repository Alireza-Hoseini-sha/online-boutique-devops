services:
  gitlab:
    image: gitlab/gitlab-ce:{{ gitlab_version }}
    container_name: gitlab
    hostname: "${GITLAB_HOSTNAME}"

    restart: unless-stopped
    shm_size: "256m"

    env_file:
      - .env

    environment:
      GITLAB_OMNIBUS_CONFIG: |
        external_url '${GITLAB_EXTERNAL_URL}'

        gitlab_rails['initial_root_email'] = '${GITLAB_ROOT_EMAIL}'
        gitlab_rails['initial_root_password'] = '${GITLAB_ROOT_PASSWORD}'

        registry_external_url '${GITLAB_REGISTRY_URL}'
        gitlab_rails['registry_enabled'] = true

        gitlab_rails['gitlab_shell_ssh_port'] = ${GITLAB_SSH_PORT}

        puma['worker_processes'] = 2
        sidekiq['concurrency'] = 10

        prometheus_monitoring['enable'] = false

        gitlab_rails['gitlab_signup_enabled'] = false

        gitlab_rails['backup_keep_time'] = 604800

        gitlab_rails['time_zone'] = '${GITLAB_TIMEZONE}'

    ports:
      - "80:80"
      - "443:443"
      - "${GITLAB_SSH_PORT}:22"
      - "5050:5050"

    volumes:
      - "./gitlab/config:/etc/gitlab"
      - "./gitlab/logs:/var/log/gitlab"
      - "./gitlab/certs:/etc/gitlab/ssl:ro"
      - "gitlab-data-vol:/var/opt/gitlab"
      - "gitlab-backup-vol:/var/opt/gitlab/backups"

    networks:
      - gitlab-net

    healthcheck:
      test: ["CMD", "curl", "-fsk", "http://127.0.0.1/-/health"]
      interval: 60s
      timeout: 10s
      retries: 5
      start_period: 300s


networks:
  gitlab-net:
    name: gitlab-net
    driver: bridge


volumes:
  gitlab-data-vol:
    name: gitlab-data-vol

  gitlab-backup-vol:
    name: gitlab-backup-vol